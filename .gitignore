# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.pnpm-store/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# Note : pnpm-lock.yaml est le lockfile officiel du projet (pnpm),
# il doit rester versionné : ne pas l'ajouter ici.

# pnpm est le SEUL gestionnaire. Un package-lock.json versionne se perime en
# silence (le dernier datait de cinq mois et ne portait AUCUNE entree pour
# `@vente-facile/core`), et un `npm install` sur cette dependance `github:`
# lance `git ls-remote`, absent de node:20-alpine : le build de production
# echouait sur `spawn git ENOENT`.
package-lock.json
yarn.lock

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.cursor

